<Window
    x:Class="RustFPSOptimizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rust Performance Suite by undeq"
    Width="1200"
    Height="750"
    MinWidth="1000"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    Background="#101114">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock
                Text="RUST PERFORMANCE SUITE"
                Foreground="White"
                FontSize="30"
                FontWeight="Bold"/>
            <TextBlock
                Text="by undeq"
                Foreground="#9B9BA1"
                FontSize="15"
                Margin="0,2,0,20"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Button Content="Dashboard"/>
                <Button Content="Optimize"/>
                <Button Content="Profiles"/>
                <Button Content="Rust"/>
                <Button Content="Benchmark"/>
                <Button Content="Live Monitor"/>
                <Button Content="Network"/>
                <Button Content="Tweak Lab"/>
                <Button Content="Cleaner"/>
                <Button Content="Hardware"/>
                <Button Content="Tools"/>
                <Button Content="License"/>
                <Button Content="Settings"/>
            </StackPanel>
            <Border
                Grid.Column="1"
                Margin="20,0,0,0"
                Padding="25"
                Background="#18191E"
                CornerRadius="12">
                <StackPanel>
                    <TextBlock
                        Text="Dashboard"
                        Foreground="White"
                        FontSize="25"
                        FontWeight="Bold"/>
                    <TextBlock
                        x:Name="SystemInfoText"
                        Text="Loading system information..."
                        Foreground="#C8C8CE"
                        FontSize="15"
                        Margin="0,20,0,20"/>
                    <TextBlock
                        Text="SYSTEM SCORE"
                        Foreground="#9B9BA1"
                        FontSize="13"/>
                    <TextBlock
                        Text="100 / 100"
                        Foreground="White"
                        FontSize="38"
                        FontWeight="Bold"/>
                    <Button
                        Content="⚡ ONE CLICK MAX FPS"
                        Height="55"
                        FontSize="18"
                        Margin="0,25,0,10"
                        Click="MaxFps_Click"/>
                    <TextBlock
                        x:Name="StatusText"
                        Text="Ready"
                        Foreground="#AFAFB5"
                        FontSize="14"
                        Margin="0,15,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
