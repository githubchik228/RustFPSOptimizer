<Window x:Class="RustFPSOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rust FPS Optimizer by undeq"
        Width="1000"
        Height="720"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>
        <!-- HEADER -->
        <DockPanel>
            <StackPanel>
                <TextBlock
                    Text="RUST FPS OPTIMIZER"
                    FontSize="30"
                    FontWeight="Bold"/>
                <TextBlock
                    Text="by undeq • MAX FPS"
                    FontSize="15"
                    Margin="0,4,0,0"
                    Opacity="0.7"/>
            </StackPanel>
            <Border
                DockPanel.Dock="Right"
                Padding="12,7"
                Margin="20,0,0,0">
                <TextBlock
                    x:Name="AdminStatus"
                    Text="Проверка..."
                    FontWeight="SemiBold"/>
            </Border>
        </DockPanel>
        <!-- PROFILES -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,18,0,14">
            <Button
                Content="⚡ MAX FPS"
                Click="MaxProfile_Click"
                Width="150"/>
            <Button
                Content="⚖️ BALANCED"
                Click="BalancedProfile_Click"
                Width="150"/>
            <Button
                Content="↩️ DEFAULT"
                Click="Restore_Click"
                Width="150"/>
            <Button
                Content="🔄 REFRESH"
                Click="Refresh_Click"
                Width="130"/>
        </StackPanel>
        <!-- MAIN -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="1.05*"/>
                <ColumnDefinition
                    Width="1*"/>
            </Grid.ColumnDefinitions>
            <!-- SYSTEM -->
            <StackPanel
                Margin="0,0,12,0">
                <GroupBox
                    Header="SYSTEM"
                    Padding="14"
                    Margin="0,0,0,12">
                    <TextBlock
                        x:Name="SystemInfo"
                        Text="Загрузка информации..."
                        TextWrapping="Wrap"/>
                </GroupBox>
                <!-- SETTINGS -->
                <GroupBox
                    Header="MAX FPS SETTINGS"
                    Padding="14">
                    <StackPanel>
                        <CheckBox
                            x:Name="PowerPlanBox"
                            Content="Максимальная производительность"
                            IsChecked="True"
                            Margin="0,5"/>
                        <CheckBox
                            x:Name="GameModeBox"
                            Content="Windows Game Mode"
                            IsChecked="True"
                            Margin="0,5"/>
                        <CheckBox
                            x:Name="GameDvrBox"
                            Content="Отключить Game DVR"
                            IsChecked="True"
                            Margin="0,5"/>
                        <CheckBox
                            x:Name="RustPriorityBox"
                            Content="Высокий приоритет Rust"
                            IsChecked="True"
                            Margin="0,5"/>
                        <CheckBox
                            x:Name="TempBox"
                            Content="Очистить временные файлы"
                            IsChecked="True"
                            Margin="0,5"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            <!-- OPTIMIZER -->
            <GroupBox
                Grid.Column="1"
                Header="OPTIMIZER"
                Padding="16">
                <StackPanel>
                    <Button
                        Content="⚡ APPLY MAX FPS"
                        Height="60"
                        FontSize="20"
                        Click="Optimize_Click"/>
                    <Button
                        Content="🧹 CLEAN TEMP"
                        Click="Clean_Click"/>
                    <Button
                        Content="↩️ RESTORE MY CHANGES"
                        Click="Restore_Click"/>
                    <Separator
                        Margin="0,12"/>
                    <TextBlock
                        Text="Rust FPS Optimizer by undeq"
                        FontWeight="Bold"
                        Margin="0,4"/>
                    <TextBlock
                        Text="Настройки сохраняются перед изменением. Defender и Easy Anti-Cheat не отключаются."
                        TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>
        </Grid>
        <!-- LOG -->
        <TextBox
            x:Name="LogBox"
            Grid.Row="3"
            Margin="0,14,0,0"
            IsReadOnly="True"
            VerticalScrollBarVisibility="Auto"
            TextWrapping="Wrap"/>
    </Grid>
</Window>
