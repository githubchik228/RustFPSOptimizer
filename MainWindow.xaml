<Window x:Class="RustFPSOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rust FPS Optimizer by undeq"
        Width="900"
        Height="650"
        MinWidth="800"
        MinHeight="550"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="RUST FPS OPTIMIZER • by undeq"
            FontSize="30"
            FontWeight="Bold"/>

        <TextBlock
            Grid.Row="1"
            Margin="0,6,0,16"
            Text="Максимальный FPS • стабильный frametime • безопасная оптимизация"/>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,10,0">

                <GroupBox Header="Профиль оптимизации"
                          Padding="12"
                          Margin="0,0,0,12">

                    <StackPanel>

                        <RadioButton
                            x:Name="Extreme"
                            Content="⚡ MAX FPS"
                            IsChecked="True"
                            FontSize="17"
                            Margin="0,5"/>

                        <RadioButton
                            x:Name="Balanced"
                            Content="⚖ BALANCED"
                            FontSize="17"
                            Margin="0,5"/>

                        <RadioButton
                            x:Name="Default"
                            Content="↩ DEFAULT"
                            FontSize="17"
                            Margin="0,5"/>

                    </StackPanel>

                </GroupBox>

                <GroupBox Header="Информация о системе"
                          Padding="12">

                    <TextBlock
                        x:Name="SystemInfo"
                        Text="Загрузка информации..."
                        TextWrapping="Wrap"/>

                </GroupBox>

            </StackPanel>

            <GroupBox
                Grid.Column="1"
                Header="Действия"
                Padding="16">

                <StackPanel>

                    <Button
                        x:Name="OptimizeButton"
                        Content="⚡ OPTIMIZE RUST"
                        Height="60"
                        FontSize="20"
                        Margin="0,0,0,10"
                        Click="Optimize_Click"/>

                    <Button
                        Content="↩ RESTORE"
                        Height="45"
                        Margin="0,0,0,10"
                        Click="Restore_Click"/>

                    <Button
                        Content="🧹 CLEAN TEMP"
                        Height="45"
                        Margin="0,0,0,10"
                        Click="Clean_Click"/>

                    <Button
                        Content="🔄 REFRESH SYSTEM INFO"
                        Height="45"
                        Click="Refresh_Click"/>

                </StackPanel>

            </GroupBox>

        </Grid>

        <TextBox
            x:Name="LogBox"
            Grid.Row="3"
            Height="140"
            Margin="0,16,0,0"
            IsReadOnly="True"
            VerticalScrollBarVisibility="Auto"
            TextWrapping="Wrap"/>

    </Grid>

</Window>
