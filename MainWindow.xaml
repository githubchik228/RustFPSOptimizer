<Window
    x:Class="RustFPSOptimizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rust Performance Suite by undeq"
    Width="1250"
    Height="800"
    MinWidth="1050"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    Background="#101114">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#24262D"/>
            <Setter Property="BorderBrush" Value="#343740"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="SidebarButton"
                TargetType="Button"
                BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background"
                    Value="Transparent"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="#22242A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#383A43"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- HEADER -->
        <StackPanel Grid.Row="0">
            <TextBlock
                Text="RUST PERFORMANCE SUITE"
                Foreground="White"
                FontSize="30"
                FontWeight="Bold"/>
            <TextBlock
                Text="by undeq"
                Foreground="#9B9BA1"
                FontSize="15"
                Margin="0,2,0,20"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- SIDEBAR -->
            <Border
                Grid.Column="0"
                Background="#18191E"
                CornerRadius="12"
                Padding="10">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="⌂  Dashboard"
                            Click="Dashboard_Click"/>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="⚡  Optimize"
                            Click="Optimize_Click"/>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="◈  Profiles"
                            Click="Profiles_Click"/>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="🎮  Rust"
                            Click="Rust_Click"/>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="▣  Benchmark"
                            Click="Benchmark_Click"/>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="◉  Live Monitor"
                            Click="LiveMonitor_Click"/>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="⌁  Network"
                            Click="Network_Click"/>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="♜  Backup"
                            Click="Backup_Click"/>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="⚙️  Tweak Lab"
                            Click="TweakLab_Click"/>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="♻️  Cleaner"
                            Click="Cleaner_Click"/>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="▤  Hardware"
                            Click="Hardware_Click"/>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="🛡️  Safety"
                            Click="Safety_Click"/>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="🔧  Tools"
                            Click="Tools_Click"/>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="🔑  License"
                            Click="License_Click"/>
                        <Button
                            Style="{StaticResource SidebarButton}"
                            Content="⚙️  Settings"
                            Click="Settings_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <!-- MAIN -->
            <Border
                Grid.Column="1"
                Margin="20,0,0,0"
                Padding="25"
                Background="#18191E"
                CornerRadius="12">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            x:Name="PageTitle"
                            Text="Dashboard"
                            Foreground="White"
                            FontSize="27"
                            FontWeight="Bold"/>
                        <TextBlock
                            x:Name="PageDescription"
                            Text="System overview."
                            Foreground="#9B9BA1"
                            FontSize="14"
                            Margin="0,5,0,25"/>
                        <!-- DASHBOARD -->
                        <StackPanel
                            x:Name="DashboardPanel">
                            <Border
                                Background="#22242A"
                                CornerRadius="10"
                                Padding="18">
                                <TextBlock
                                    x:Name="SystemInfoText"
                                    Foreground="#D5D5DA"
                                    FontSize="15"
                                    TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock
                                Text="OPTIMIZATION"
                                Foreground="#9B9BA1"
                                Margin="0,25,0,0"/>
                            <TextBlock
                                x:Name="OptimizationStatus"
                                Text="Ready"
                                Foreground="White"
                                FontSize="25"
                                FontWeight="Bold"/>
                            <Button
                                Content="⚡ ONE CLICK MAX FPS"
                                Height="55"
                                FontSize="18"
                                Margin="0,25,0,10"
                                Click="MaxFps_Click"/>
                        </StackPanel>
                        <!-- OTHER PAGES -->
                        <StackPanel
                            x:Name="PagePanel"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="PageContent"
                                Foreground="#C8C8CE"
                                FontSize="16"
                                TextWrapping="Wrap"
                                Margin="0,0,0,15"/>
                            <StackPanel
                                x:Name="ActionPanel"/>
                        </StackPanel>
                        <TextBlock
                            x:Name="StatusText"
                            Text="Ready"
                            Foreground="#AFAFB5"
                            FontSize="14"
                            Margin="0,25,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
