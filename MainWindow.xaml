<Window
    x:Class="RustFPSOptimizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rust Performance Suite by undeq"
    Width="1250"
    Height="780"
    MinWidth="1050"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    Background="#101114">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock
                Text="RUST PERFORMANCE SUITE"
                Foreground="White"
                FontSize="30"
                FontWeight="Bold"/>
            <TextBlock
                Text="by undeq"
                Foreground="#9B9BA1"
                FontSize="15"
                Margin="0,2,0,20"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer
                Grid.Column="0"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Button Content="Dashboard"
                            Click="Dashboard_Click"/>
                    <Button Content="Optimize"
                            Click="Optimize_Click"/>
                    <Button Content="Profiles"
                            Click="Profiles_Click"/>
                    <Button Content="Rust"
                            Click="Rust_Click"/>
                    <Button Content="Benchmark"
                            Click="Benchmark_Click"/>
                    <Button Content="Live Monitor"
                            Click="LiveMonitor_Click"/>
                    <Button Content="Network"
                            Click="Network_Click"/>
                    <Button Content="Tweak Lab"
                            Click="TweakLab_Click"/>
                    <Button Content="Cleaner"
                            Click="Cleaner_Click"/>
                    <Button Content="Hardware"
                            Click="Hardware_Click"/>
                    <Button Content="Tools"
                            Click="Tools_Click"/>
                    <Button Content="License"
                            Click="License_Click"/>
                    <Button Content="Settings"
                            Click="Settings_Click"/>
                </StackPanel>
            </ScrollViewer>
            <Border
                Grid.Column="1"
                Margin="20,0,0,0"
                Padding="25"
                Background="#18191E"
                CornerRadius="12">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            x:Name="PageTitle"
                            Text="Dashboard"
                            Foreground="White"
                            FontSize="26"
                            FontWeight="Bold"/>
                        <TextBlock
                            x:Name="PageDescription"
                            Text="System overview."
                            Foreground="#9B9BA1"
                            FontSize="14"
                            Margin="0,5,0,25"/>
                        <StackPanel
                            x:Name="DashboardPanel">
                            <TextBlock
                                x:Name="SystemInfoText"
                                Foreground="#C8C8CE"
                                FontSize="15"
                                TextWrapping="Wrap"/>
                            <TextBlock
                                Text="SYSTEM SCORE"
                                Foreground="#9B9BA1"
                                Margin="0,25,0,0"/>
                            <TextBlock
                                Text="100 / 100"
                                Foreground="White"
                                FontSize="38"
                                FontWeight="Bold"/>
                            <Button
                                Content="⚡ ONE CLICK MAX FPS"
                                Height="55"
                                FontSize="18"
                                Margin="0,25,0,10"
                                Click="MaxFps_Click"/>
                        </StackPanel>
                        <StackPanel
                            x:Name="PagePanel"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="PageContent"
                                Foreground="#C8C8CE"
                                FontSize="16"
                                TextWrapping="Wrap"/>
                            <StackPanel
                                x:Name="ActionPanel"
                                Margin="0,25,0,0"/>
                        </StackPanel>
                        <TextBlock
                            x:Name="StatusText"
                            Text="Ready"
                            Foreground="#AFAFB5"
                            FontSize="14"
                            Margin="0,25,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
